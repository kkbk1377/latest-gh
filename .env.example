# GEMINI_API_KEY: Optional Gemini API key injected by AI Studio runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL of the application.
APP_URL="https://trinetrasolutions.online"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform JavaScript API key.
VITE_GOOGLE_MAPS_API_KEY=""

# ADMIN_PASSCODE: Server-side passcode for the TRINETRA Admin Settings portal.
# Never expose this variable with a VITE_ prefix.
ADMIN_PASSCODE=""

# SESSION_SECRET: Random server-side secret used to sign admin session tokens.
SESSION_SECRET=""
